# Docker Compose variables for the eCommerce lab. Copy to ".env" IN THIS
# DIRECTORY to override the built-in defaults. Compose reads .env from the
# compose file's directory (labs/ecommerce/), not the repo root.

# Dependency credentials (replace for anything shared).
POSTGRES_PASSWORD=ecommerce

# Local-development JWT signing key (HS256 needs >= 32 chars). NOT a production
# secret; used only by this local lab.
JWT_KEY=ecommerce-lab-local-dev-signing-key-do-not-use-in-production

# Seeded data size for the application: smoke | demo.
SEED_SCALE=smoke

# Head-sampling ratio for traces reaching Tempo.
PERFLAB_TRACE_SAMPLE_RATIO=0.25

# Consumed only by a manual `docker compose up`; the harness sets these per run.
PERF_SCENARIO=E00
PERF_RUN_ID=local-manual
PERF_RUN_MODE=measure
