<?xml version="1.0" encoding="utf-8"?>
<!-- Pin a single package source so central package management restores
     deterministically on any host (clears inherited machine/user sources such
     as private GitHub feeds). Docker builds already use a clean image. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
