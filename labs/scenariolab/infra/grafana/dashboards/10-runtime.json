    {
      "id": 101,
      "title": "Memory",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 102,
      "title": "Working set vs managed heap vs committed",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "description": "api mem_limit is 768 MiB; GCHeapHardLimitPercent caps managed heap. Watch working set vs limit.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 2,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "dotnet_process_memory_working_set_bytes{service_name=~\"$service\",service_instance_id=~\"$instance\"}",
          "refId": "A",
          "legendFormat": "working set {{service_name}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name)(dotnet_gc_last_collection_heap_size_bytes{service_name=~\"$service\",service_instance_id=~\"$instance\"})",
          "refId": "B",
          "legendFormat": "managed heap {{service_name}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name)(dotnet_gc_last_collection_memory_committed_size_bytes{service_name=~\"$service\",service_instance_id=~\"$instance\"})",
          "refId": "C",
          "legendFormat": "GC committed {{service_name}}"
        }
      ]
    },
    {
      "id": 103,
      "title": "Managed heap by generation",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "description": "gen0/gen1/gen2/loh/poh. Rising gen2/loh = long-lived or large-object pressure.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25,
            "showPoints": "never",
            "lineWidth": 2,
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gc_heap_generation)(dotnet_gc_last_collection_heap_size_bytes{service_name=~\"$service\",service_instance_id=~\"$instance\"})",
          "refId": "A",
          "legendFormat": "{{gc_heap_generation}}"
        }
      ]
    },
