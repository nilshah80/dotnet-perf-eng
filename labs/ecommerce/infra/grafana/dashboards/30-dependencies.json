          "expr": "histogram_quantile(0.95, sum by (le)(rate(http_client_request_time_in_queue_seconds_bucket{service_name=~\"$service\",service_instance_id=~\"$instance\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "queue p95"
        }
      ]
    },
