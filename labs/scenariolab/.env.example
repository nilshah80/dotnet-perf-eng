# Docker Compose variables for this lab. Copy to ".env" IN THIS DIRECTORY to
# override the built-in defaults -- every value here is optional, and Compose
# reads .env from the compose file's directory (labs/scenariolab/), not the repo
# root.
#
# This file is ONLY for compose interpolation. Harness configuration (service
# names, endpoints, dependencies, load-generator default) lives in lab.config.sh,
# and per-run overrides (PERFLAB_LOAD_GENERATOR, PERFLAB_WRK_IMAGE, CLAUDE_MODEL,
# CLAUDE_MAX_BUDGET_USD, ...) are shell environment variables -- none of those
# belong here.

# Dependency credentials (replace for anything shared).
POSTGRES_PASSWORD=perflab
RABBITMQ_PASSWORD=perflab

# Seeded data size for the application.
SEED_SCALE=smoke

# Head-sampling ratio for traces reaching Tempo. Raise toward 1.0 for a single
# scenario when the extreme tail is the subject.
PERFLAB_TRACE_SAMPLE_RATIO=0.25

# Consumed only by a manual `docker compose up`; the harness sets these per run.
PERF_SCENARIO=S00
PERF_RUN_ID=local-manual
PERF_RUN_MODE=measure
