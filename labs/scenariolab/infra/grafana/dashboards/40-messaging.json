    },
    {
      "id": 102,
      "title": "Publish / process / retry per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "description": "published>processed for a sustained period = the worker is falling behind (see broker queue depth).",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 2,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(perflab_orders_published_total{service_name=~\"$service\",scenario_id=~\"$scenario\",perf_run_id=~\"$run\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "published/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(perflab_orders_processed_total{service_name=~\"$service\",scenario_id=~\"$scenario\",perf_run_id=~\"$run\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "processed/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(perflab_orders_retried_total{service_name=~\"$service\",scenario_id=~\"$scenario\",perf_run_id=~\"$run\"}[$__rate_interval]))",
          "refId": "C",
          "legendFormat": "retried/s"
        }
      ]
    },
    {
      "id": 103,
      "title": "Order processing duration p95/p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 2,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le)(rate(perflab_order_processing_duration_milliseconds_bucket{service_name=~\"$service\",scenario_id=~\"$scenario\",perf_run_id=~\"$run\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le)(rate(perflab_order_processing_duration_milliseconds_bucket{service_name=~\"$service\",scenario_id=~\"$scenario\",perf_run_id=~\"$run\"}[$__rate_interval])))",
          "refId": "B",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 104,
      "title": "Correctness failures (total in window)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "description": "Guards against 'fast but wrong'. Must stay 0 -- any value invalidates a throughput win.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(perflab_correctness_failures_total{service_name=~\"$service\",scenario_id=~\"$scenario\",perf_run_id=~\"$run\"}[$__range])) or vector(0)",
          "refId": "A"
        }
      ]
    },
