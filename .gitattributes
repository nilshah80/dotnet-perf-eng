# Line endings in this repository are not a cosmetic preference. The same files
# are consumed by Git Bash/MSYS on Windows, by bash on macOS and Linux, and by
# Linux containers that bind-mount them straight off the host working tree
# (compose.yaml mounts ./ into diagnostics, plus infra/postgres/init.sql,
# infra/rabbitmq/enabled_plugins, and the two Grafana provisioning files).
#
# Without this file the invariant held only by accident, because the Windows
# clone happened to have core.autocrlf=true. One clone with core.autocrlf=false
# puts CRLF into the index, and a macOS or Linux checkout then fails on the very
# first line of every entry point with "env: bash\r: No such file or directory".
#
# `text=auto` normalizes the index to LF; the explicit `eol=lf` entries also pin
# the working tree, which is what the container bind mounts actually read.
* text=auto

# Executed as programs: a CR in the shebang or after a line continuation breaks
# them outright.
*.sh            text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf

# Read by the load generators, which run on the host but parse these verbatim.
*.lua           text eol=lf
*.js            text eol=lf
*.jmx           text eol=lf
*.jtl           text eol=lf
*.csv           text eol=lf
*.txt           text eol=lf
*.xml           text eol=lf
*.jsonl         text eol=lf
*.ndjson        text eol=lf

# Plans and repository documentation are compared byte-for-byte across
# platforms and repositories.
*.md            text eol=lf

# Differential analysers (diff-*.py) are piped as source into a python container
# (python3 -c); a CR in that source is fragile across CPython versions.
*.py            text eol=lf

# Scenario catalog, parsed by the harness with awk on the host.
*.tsv           text eol=lf

# Bind-mounted into Linux containers and parsed by Postgres, RabbitMQ (an Erlang
# term file), and Grafana provisioning.
*.sql           text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.json          text eol=lf
enabled_plugins text eol=lf

# Parsed by docker compose on the host; a stray CR would corrupt a value.
.env            text eol=lf
.env.example    text eol=lf

# Diagnostic fixtures and retained artifacts must never be line-normalized.
*.nettrace      binary
*.gcdump        binary
*.dmp           binary
*.jfr           binary
*.hprof         binary
*.pprof         binary
*.speedscope    binary
*.cpuprofile    binary
*.heapsnapshot  binary

# Archives, images, documents, and fonts are binary.
*.gz    binary
*.zip   binary
*.tar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
