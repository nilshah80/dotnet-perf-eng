    {
      "id": 113,
      "title": "Buffer cache hit ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 27
      },
      "description": "Fraction of block reads served from shared_buffers; sustained dips below ~0.99 mean disk reads.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 2,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_blks_hit_total{datname=~\"perflab|ecommerce\"}[$__rate_interval])) / clamp_min(sum(rate(pg_stat_database_blks_hit_total{datname=~\"perflab|ecommerce\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read_total{datname=~\"perflab|ecommerce\"}[$__rate_interval])), 1)",
          "refId": "A",
          "legendFormat": "hit ratio"
        }
      ]
    }
