    {
      "id": 106,
      "title": "Cache hit ratio (app view)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "description": "From perflab_cache_requests{cache_result}. Compare with Redis server-side ratio on Dependencies.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 2,
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(perflab_cache_requests_total{service_name=~\"$service\",scenario_id=~\"$scenario\",perf_run_id=~\"$run\",cache_result=\"hit\"}[$__rate_interval])) / clamp_min(sum(rate(perflab_cache_requests_total{service_name=~\"$service\",scenario_id=~\"$scenario\",perf_run_id=~\"$run\"}[$__rate_interval])), 1)",
          "refId": "A",
          "legendFormat": "hit ratio"
        }
      ]
    },
