      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name)(rate(dotnet_gc_pause_time_seconds_total{service_name=~\"$service\",service_instance_id=~\"$instance\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
