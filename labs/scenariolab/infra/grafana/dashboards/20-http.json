      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_route)(rate(http_server_request_duration_seconds_count{service_name=~\"$service\",service_instance_id=~\"$instance\",http_route!~\"/health.*|\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{http_route}}"
